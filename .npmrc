# Default to plain-copy package installs instead of hardlinks. Some mounted/
# network filesystems (FUSE mounts in particular) don't support the
# hardlink-then-unlink dance pnpm's default "hardlink" import method uses to
# populate node_modules from its content-addressable store, and fail with
# EPERM on the unlink step. "copy" works everywhere at a small disk-space and
# speed cost.
package-import-method=copy
