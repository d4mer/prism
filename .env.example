# Path to the OKF bundle directory the agent manages
BUNDLE_ROOT=./sample-bundle

# ── Primary model ──────────────────────────────────────────────────────
# Any OpenAI-compatible or Anthropic-compatible API endpoint.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_FORMAT=openai          # "openai" | "anthropic"
LLM_MODEL=                     # model id to request, e.g. "deepseek-chat" or "claude-sonnet-5"

# ── Fallback model (optional) ──────────────────────────────────────────
# Used when the primary model fails with a retryable error (timeout, 5xx).
# Leave LLM_FALLBACK_API_BASE_URL empty to disable fallback.
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_FORMAT=openai
LLM_FALLBACK_MODEL=
# LLM_FALLBACK_ALLOW_FOR=query   # optional: restrict to read-only operations

# ── Embeddings (optional) ───────────────────────────────────────────────
# Separate from the chat LLM above — a bundle can have a chat model, an
# embeddings model, both, or neither. Enables semantic/hybrid search
# (finds concepts that share no keywords with the query) and is generated
# only by `prism maintain` in the background, never on a search request.
# Leave EMBEDDING_API_BASE_URL empty to keep search purely keyword-based.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=                # e.g. "text-embedding-3-small" (OpenAI), "voyage-3" (Voyage)

# ── Legacy env vars (still work but deprecated) ─────────────────────────
# Prefer the LLM_API_* vars above. These are mapped automatically.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# LLAMACPP_BASE_URL=
# LLAMACPP_API_KEY=
# LOCAL_BASE_URL=
# LOCAL_API_KEY=

# Commit bundle changes to git after each mutation
GIT_AUTOCOMMIT=false

PORT=3800

# Bind address. 0.0.0.0 (default) listens on every interface — fine on a
# trusted LAN, but reachable from anywhere that can route to this machine.
# Set HOST=127.0.0.1 for a setup that's never reachable off-box at all.
HOST=0.0.0.0

# Optional: require "Authorization: Bearer <token>" on /mcp, /api and /api/v1.
# Unset = open (fine for localhost/LAN). Set this before exposing Prism beyond
# localhost — if you don't, and HOST isn't loopback, the server logs a loud
# startup warning every time it starts, because anyone who can reach it can
# then read AND write the knowledge base with no credentials.
#AUTH_TOKEN=

# Query cache: repeated memory_query questions answer from cache until the
# bundle changes. QUERY_CACHE=false disables; QUERY_CACHE_TTL e.g. "1h" (default 24h).
#QUERY_CACHE=true
#QUERY_CACHE_TTL=24h

# Hot memory: recent writes + recent answers form a working set that queries
# check with one cheap tool-free LLM call before the full agent run.
#HOT_MEMORY=true
#HOT_MEMORY_TTL=1h

# Dreaming: autonomous memory consolidation on an interval (opt-in).
# Deterministic signals (orphans, broken links, likely duplicates, oversized
# concepts, recent activity) decide if there's anything to do — a healthy
# memory costs nothing.
#DREAM_INTERVAL=6h
#DREAM_INSIGHTS=true

# ── Search index freshness (PRISM-36) ──
# Once a search index exists (.prism/, built by `prism maintain`), Prism keeps
# it in step with edits made OUTSIDE Prism (Obsidian, VS Code, git pull):
# one reconcile at startup, then a file watcher (debounced, so a big git
# checkout is one reindex). Where file events don't arrive (some network
# shares / container bind mounts), set INDEX_WATCH=false to poll instead.
#INDEX_WATCH=true
#INDEX_POLL_INTERVAL=60s
